# PostgreSQL 数据库配置示例
# 复制此文件到项目根目录的 .env 文件中

# 生产库（Neon）。所有脚本都读这个；没有它会直接报错，
# 而不是悄悄回落到本地库。
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/crm?sslmode=require

# 本地 PostgreSQL 连接信息。--test 写入的 crm_test 用这组；
# 生产连接不会用，除非显式设置 ALLOW_LOCAL_DB=1。
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=crm
PG_DATABASE_TEST=crm_test
PG_USER=postgres
PG_PASSWORD=your_password_here
