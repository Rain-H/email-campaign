# Read-only connection string to the same Neon Postgres DB the campaign
# CRM already uses. This app only ever issues SELECT queries.
#
# Local dev: copy this file to .env.local and fill in the real value
# (same DATABASE_URL as the repo-root .env).
#
# Vercel: set as a Project Environment Variable instead (Settings ->
# Environment Variables), not committed here.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"
